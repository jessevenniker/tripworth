# Copy to .env.local and fill in.

# Public address of the site (no trailing slash). Used for canonical URLs, hreflang and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" on the real domain only. Without it robots.txt blocks all crawlers.
ALLOW_INDEXING=false

# Stripe: use the test keys (sk_test_...) while developing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to "true" once Stripe Tax is switched on in the Stripe dashboard.
STRIPE_TAX_ENABLED=false
# Set to "true" to show a required "I agree" checkbox (waiver of the EU withdrawal right) in Checkout.
# First enter the terms URL (https://<domain>/terms) under Settings > Public details in Stripe.
STRIPE_REQUIRE_TERMS=false

# Any long random string (for example: openssl rand -base64 32). Signs the PDF download links.
# Changing it invalidates every download link that is still open.
DOWNLOAD_SECRET=

# Private storage for the paid PDFs (Vercel Blob, private store). Vercel sets this when the store is connected
# to the project. Empty = read the PDFs from private/pdfs (local development). See STRIPE-TODO.md.
BLOB_READ_WRITE_TOKEN=

# Resend: emails the download link after payment. Leave both empty to send no email
# (the buyer then only gets the link on the thank-you page).
RESEND_API_KEY=
# Sender on a domain verified in Resend, for example: Tripsworth <guides@example.com>
EMAIL_FROM=
# Optional: where replies from buyers go.
EMAIL_REPLY_TO=

# Affiliate IDs. Both have defaults in src/data/articles.ts; set these only to override them.
VIATOR_PARTNER_ID=
GYG_PARTNER_ID=

# Plausible Analytics: the domain exactly as added in Plausible (e.g. example.com). Empty = no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional: a different Plausible script URL (for example a site-specific or self-hosted one).
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Google Search Console: the content value of the HTML-tag verification method. Not needed with DNS verification.
GOOGLE_SITE_VERIFICATION=
